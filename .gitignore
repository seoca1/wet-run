# Audio assets (2026-11-02 dedup — ADR-0253)
# v1 originals are transcoding sources only: the dashboard plays docs/dashboard/sounds/full/*.mp3.
# Kept local-only — anchored so sounds/v2/ and sounds/full/ are unaffected.
/docs/dashboard/sounds/theme_*.wav
# Regenerable import-script backups (docs/dashboard/scripts/import_minimax_track.sh)
/docs/dashboard/sounds/*.v1_backup.wav
/docs/dashboard/sounds/*_v1_orig.wav
