    "story": {
      "source": "xauthors/true-names/en/2026-10-11_far_grid_prelude",
      "title": "Far Grid Prologue"
    },
    "briefing": "The operator silhouette offers the deck jockey a first walk along the Coven's narrow row of stones, with no fight and no contract — just a measured first step.",
    "title_ko": "FAR GRID 전주곡",
    "briefing_ko": "조작자의 실루엣이 데커에게 코벤의 좁은 돌다리를 따라 첫 산책을 제안한다. 싸움도 계약도 없이 — 고요한 첫 걸음뿐이다."
  },
  "don_mac_audit": {
    "id": "don_mac_audit",
