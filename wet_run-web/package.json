{
  "name": "wetrun-web",
  "version": "0.1.0",
  "description": "Browser MVP of wet_run — TypeScript + Canvas2D ASCII renderer. Tier 1 of web version per ADR-0199.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "smoke": "playwright test e2e/smoke.spec.ts",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "export-data": "python3 scripts/export_web_data.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@types/howler": "^2.2.13",
    "howler": "^2.2.4",
    "lz-string": "^1.5.0"
  }
}
